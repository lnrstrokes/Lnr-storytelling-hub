+  /** Bare host for the site line: no protocol, no trailing slash. */
+  function normalizeSite(value) {
+    return String(value == null ? '' : value)
+      .trim()
+      .replace(/^https?:\/\//i, '')
+      .replace(/^\/\//, '')
+      .replace(/\/+$/, '')
+      .slice(0, 42);
+  }
