{
  "id": "/",
  "name": "lnr Studio — LNR Storytelling Hub",
  "short_name": "lnr Studio",
  "description": "Four broadcast engines in one app: live interactive quiz, Guess-the-Player cards, documentary storytelling, and an unattended video loop. No server, no signup.",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["entertainment", "productivity"],
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "start_url": "/?src=pwa",
  "launch_handler": { "client_mode": "navigate-existing" },
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c1210",
  "theme_color": "#0c1210",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}