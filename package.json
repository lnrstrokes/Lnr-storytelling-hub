{
  "name": "react-example",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/assemble-og-image.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --external:vite --outfile=server.cjs",
    "start": "node server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
