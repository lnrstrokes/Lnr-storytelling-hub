{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/timer", "destination": "/index.html" },
    { "source": "/timer/(.*)", "destination": "/index.html" },
    { "source": "/classic", "destination": "/index.html" },
    { "source": "/classic/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "comment": "The service worker must never be cached by the CDN or the app cannot update.",
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/promos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
