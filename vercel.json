{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/timer", "destination": "/index.html" },
    { "source": "/timer/(.*)", "destination": "/index.html" },
    { "source": "/classic", "destination": "/index.html" },
    { "source": "/classic/(.*)", "destination": "/index.html" }
  ]
}
